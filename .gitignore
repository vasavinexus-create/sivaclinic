# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.dev-server*.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# local build caches
/.gradle-local/
/.gradle/

# capacitor / android generated outputs
/android/.gradle/
/android/build/
/android/app/build/
/android/app/release/
/android/app/debug/
*.apk
*.aab

# local editor / OS files
.idea/
.vscode/
Thumbs.db
desktop.ini

# temporary imports and generated OCR/PDF working files
/tmp/
*.tmp
*.temp

# local logs and reports
*.log
/android/build/reports/
